<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
      Wealth pane, 2026 revision: the notification listener below cannot see
      anything that arrived before access was granted, so it can never answer
      "what did I spend last month". READ_SMS is what backfills the inbox via
      Telephony; RECEIVE_SMS is what keeps the live feed current. This app is
      never distributed through Play (see the debug-signed release config in
      app/build.gradle.kts), so the restricted-permission review that CLAUDE.md
      originally warned about does not apply here — that note predates this
      decision and is left in place as history, not as a constraint that still
      binds. We are not registering as the default SMS app: no SMS_DELIVER,
      no compose UI, no sending. See SmsReceiver.kt for where that boundary is.
    -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!-- Package visibility: enough to enumerate launchable activities on API 30+. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Angel">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:theme="@style/Theme.Angel">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Secondary Money pane source, kept for messages a bank never sends
             by SMS (some notification-only fintech apps). SMS is now the
             source of truth; see PaymentNotificationListener.kt. -->
        <service
            android:name=".money.PaymentNotificationListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Live SMS feed. No SMS_DELIVER / default-handler role: this only
             ever reads, never composes or sends. A default-handler upgrade
             (SMS_DELIVER + abortBroadcast) could raise priority above other
             receivers, but backfill + this receiver already gives complete
             coverage, so there has been no need for it. -->
        <receiver
            android:name=".money.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
